# ------------------------------------------------------------------
# SS Solutions — environment variables
# Copy to .env.local and fill in. NONE of these are required to run.
# Every channel that is filled in runs; you can combine them.
# ------------------------------------------------------------------

# Canonical public URL (used for metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://sssolutions.dev

# --- WhatsApp notification on form submit (both partner numbers) ---
# Recipients come from src/data/company.ts (people[0], people[1]).

# Option 1 — CallMeBot (free, no Meta Business account). Each partner sends
# "I allow callmebot to send me messages" on WhatsApp to +34 644 51 95 23
# and gets a personal API key. KEY_1 -> people[0], KEY_2 -> people[1].
CALLMEBOT_APIKEY_1=
CALLMEBOT_APIKEY_2=

# Option 2 — Twilio WhatsApp (reliable). Each partner sends "join <code>" to
# the Twilio sandbox number once. Get SID + token from the Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Option 3 — Meta WhatsApp Cloud API (official). Needs a Business SENDER
# number + an approved template with ONE body variable {{1}} (category: Utility).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=new_lead
WHATSAPP_TEMPLATE_LANG=en

# --- Simplest way to get the filled form by email ---
# web3forms.com -> type your email -> they email you an access key. No account.
WEB3FORMS_ACCESS_KEY=

# --- Also / instead: other delivery channels ---

# Generic webhook (Zapier / Make / n8n / your own API)
# Easiest no-code WhatsApp: point this at a Make/Zapier webhook and add
# "WhatsApp -> Send message" steps for each number inside the scenario.
CONTACT_WEBHOOK_URL=

# Email via Gmail (SMTP). Turn on 2-Step Verification, then create an
# "App password" (Google Account -> Security -> App passwords). Sends to
# company.email in src/data/company.ts unless CONTACT_TO_EMAIL is set.
GMAIL_USER=sssolutions7070@gmail.com
GMAIL_APP_PASSWORD=

# Formspree endpoint
FORMSPREE_ENDPOINT=

# Resend transactional email (alternative to Gmail)
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# --- Analytics (optional) ---
# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave empty to skip.
# Vercel Analytics + Speed Insights need no key — they switch on automatically on Vercel.
NEXT_PUBLIC_GA_ID=
